APP_NAME=Paytm Merchant Growth Copilot API
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]
AI_PROVIDER=rules
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=20
# Optional for AI_PROVIDER=openai-compatible. Keep the key only in backend/.env.
# AI_API_KEY=your-private-provider-key
